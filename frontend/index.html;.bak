<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ParlayMind Logger</title>
  <style>
    body { font-family: Arial; max-width: 600px; margin: 40px auto; }
    input, textarea { width: 100%; margin-bottom: 10px; padding: 6px; }
    button { padding: 10px 20px; cursor: pointer; }
  </style>
</head>
<body>
  <h2>ParlayMind Bet Entry</h2>
  <form id="betForm">
    <label>Sport:</label>
    <input type="text" id="sport" value="NFL" required>

    <label>Stake ($):</label>
    <input type="number" id="stake" value="10" required>

    <label>Parlay Odds (American):</label>
    <input type="number" id="odds" value="4500" required>

    <label>Legs (one per line, format: desc|odds):</label>
    <textarea id="legs" rows="4" placeholder="Mahomes 250+ yds|110"></textarea>

    <button type="submit">Submit Bet</button>
  </form>

  <script>
    document.getElementById('betForm').addEventListener('submit', async e => {
      e.preventDefault();
      const legsInput = document.getElementById('legs').value.trim().split('\n');
      const legs = legsInput.map(line => {
        const [desc, odds] = line.split('|');
        return { desc: desc.trim(), odds: parseFloat(odds) };
      });
	  
	fetch(`/api/context/ai/${encodeURIComponent(teamName)}`)
		.then(r => r.json())
		.then(data => {
			if (data.risk_adj > 0.2) highlightLeg(teamName, "⚠️ boosted risk");
			else if (data.risk_adj < -0.2) highlightLeg(teamName, "✅ stable");
		});

    const bet = {
        sport: document.getElementById('sport').value,
        stake: parseFloat(document.getElementById('stake').value),
        parlay_odds: parseFloat(document.getElementById('odds').value),
        legs: legs
    };

    const res = await fetch('http://127.0.0.1:5200/api/bet', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(bet)
    });

    const data = await res.json();
    alert('Bet logged! ID: ' + data.bet_id);
    document.getElementById('betForm').reset();
    });
  </script>
</body>
</html>
